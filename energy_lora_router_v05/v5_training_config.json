{
  "project": "energy_lora_router_v05",
  "profile": "agent_dispatch_training",
  "base_model": "google/gemma-4-e2b-it",
  "output_name": "gemma_dispatch_v05",
  "data_version": "v05",
  "train_file": "data/processed/train_v05_dispatch.jsonl",
  "val_file": "data/processed/val_v05_dispatch.jsonl",
  "smoke_file": "data/processed/smoke_v05_dispatch.jsonl",
  "manifest_file": "data/processed/harness_v05_manifest.json",
  "precision": {
    "load_in_4bit": false,
    "bf16": "auto",
    "fp16": "auto_inverse"
  },
  "lora": {
    "r": 32,
    "alpha": 64,
    "dropout": 0
  },
  "training": {
    "num_train_epochs": 1,
    "max_seq_length": 2048,
    "per_device_train_batch_size": 8,
    "gradient_accumulation_steps": 4,
    "effective_batch_size": 32,
    "learning_rate": 3e-5,
    "warmup_ratio": 0.03,
    "save_steps": 40,
    "eval_steps": 40,
    "save_total_limit": 3
  },
  "notes": [
    "v05 is for dispatch_type / workflow_id / answerability / entity_lock training.",
    "Do not train directly on raw DeepSeek dispatch JSONL; convert it to chat messages first.",
    "Keep v04 outputs in the v04 folder only. v05 outputs should write under outputs/gemma_dispatch_v05."
  ]
}
